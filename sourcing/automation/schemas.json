{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zinemachine.example/schemas/plm.json",
  "title": "Zine Machine v3 execution layer: system-of-record entities",
  "description": "Entities stored in Postgres (item master, transactions) with CAD/ECAD and released documents in Git. Every mutable entity carries id, rev/version, created_at, updated_at. Money is integer minor units plus ISO 4217 currency. All ids are prefixed ULIDs.",
  "$defs": {
    "Id": { "type": "string", "pattern": "^[a-z]{2,4}_[0-9A-HJKMNP-TV-Z]{26}$", "description": "Prefixed ULID, e.g. prt_01JC..., sup_01JC..." },
    "Money": {
      "type": "object", "required": ["amount_minor", "currency"], "additionalProperties": false,
      "properties": { "amount_minor": { "type": "integer" }, "currency": { "type": "string", "pattern": "^[A-Z]{3}$" } }
    },
    "Timestamp": { "type": "string", "format": "date-time" },
    "Actor": {
      "type": "object", "required": ["kind", "id"], "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["human", "agent", "system", "external"] },
        "id": { "type": "string", "description": "human: user id; agent: agent name@version; external: supplier contact id" },
        "run_id": { "type": "string", "description": "Agent run / Temporal workflow id, for trace correlation" }
      }
    },
    "GitRef": {
      "type": "object", "required": ["repo", "commit"], "additionalProperties": false,
      "properties": {
        "repo": { "type": "string" }, "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "path": { "type": "string" }, "tag": { "type": "string" }
      }
    },
    "Attachment": {
      "type": "object", "required": ["sha256", "mime", "uri"], "additionalProperties": false,
      "properties": {
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "mime": { "type": "string" },
        "uri": { "type": "string", "description": "Content-addressed object store URI (r2://, s3://)" },
        "filename": { "type": "string" },
        "trust": { "enum": ["internal", "untrusted", "quarantined", "sanitized"] }
      }
    },

    "Part": {
      "type": "object",
      "required": ["id", "ipn", "rev", "lifecycle", "category", "description", "uom"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "ipn": { "type": "string", "pattern": "^ZM-[0-9]{3}-[0-9]{4}$", "description": "Internal part number, e.g. ZM-110-0001 (PCBA), ZM-300-0003 (PB2 Industrial)" },
        "rev": { "type": "string", "pattern": "^[A-Z]{1,2}$|^[0-9]+$" },
        "lifecycle": { "enum": ["concept", "prototype", "pilot", "production", "nrnd", "obsolete"] },
        "category": { "enum": ["pcb", "pcba", "electronic", "module", "display", "mechanical", "fastener", "plastic", "packaging", "assembly", "consumable"] },
        "description": { "type": "string", "maxLength": 200 },
        "uom": { "enum": ["ea", "m", "g", "set", "reel"] },
        "make_buy": { "enum": ["make", "buy", "consign"] },
        "mpns": {
          "type": "array",
          "items": {
            "type": "object", "required": ["manufacturer", "mpn", "status"], "additionalProperties": false,
            "properties": {
              "manufacturer": { "type": "string" }, "mpn": { "type": "string" },
              "status": { "enum": ["approved", "alternate", "pending_qual", "disqualified"] },
              "octopart_id": { "type": "string" }, "lcsc": { "type": "string", "pattern": "^C[0-9]+$" },
              "lifecycle_vendor": { "enum": ["active", "nrnd", "eol", "obsolete", "unknown"] }
            }
          }
        },
        "design_source": { "$ref": "#/$defs/GitRef", "description": "KiCad / FreeCAD source for made parts" },
        "compliance": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "rohs": { "enum": ["yes", "no", "unknown"] }, "reach_svhc": { "type": "boolean" },
            "hts_code": { "type": "string", "pattern": "^[0-9]{4}\\.[0-9]{2}(\\.[0-9]{2,4})?$" },
            "eccn": { "type": "string", "default": "EAR99" }, "country_of_origin": { "type": "string", "pattern": "^[A-Z]{2}$" },
            "un38_3": { "type": "boolean", "description": "Batteries only" }
          }
        },
        "bom": {
          "type": "array", "description": "Children for assemblies (single-level; multi-level is recursive through child part ids)",
          "items": {
            "type": "object", "required": ["child", "qty"], "additionalProperties": false,
            "properties": {
              "child": { "$ref": "#/$defs/Id" }, "qty": { "type": "number", "exclusiveMinimum": 0 },
              "refdes": { "type": "array", "items": { "type": "string" } }, "dnp": { "type": "boolean", "default": false },
              "scrap_pct": { "type": "number", "minimum": 0, "maximum": 50 }
            }
          }
        },
        "created_at": { "$ref": "#/$defs/Timestamp" }, "updated_at": { "$ref": "#/$defs/Timestamp" }
      }
    },

    "Supplier": {
      "type": "object", "required": ["id", "name", "kind", "status", "contacts"], "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "name": { "type": "string" },
        "kind": { "enum": ["distributor", "manufacturer", "pcb_fab", "ems", "molder", "printer", "logistics", "broker"] },
        "status": { "enum": ["prospect", "approved", "conditional", "blocked"] },
        "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "api": { "enum": ["digikey_v4", "mouser_v1", "nexar", "lcsc", "jlcpcb", "none"] },
        "payment_terms": { "type": "string", "examples": ["prepaid_card", "net30", "tt_50_50"] },
        "contacts": {
          "type": "array",
          "items": {
            "type": "object", "required": ["id", "name", "channels"], "additionalProperties": false,
            "properties": {
              "id": { "$ref": "#/$defs/Id" }, "name": { "type": "string" }, "role": { "type": "string" },
              "channels": {
                "type": "array",
                "items": {
                  "type": "object", "required": ["type", "value"], "additionalProperties": false,
                  "properties": {
                    "type": { "enum": ["email", "phone", "wechat", "portal"] },
                    "value": { "type": "string" },
                    "verified": { "type": "boolean", "description": "Out-of-band verified by a human (anti-BEC)" },
                    "call_consent": { "enum": ["none", "verbal_logged", "written"], "default": "none" },
                    "recording_consent_state": { "type": "string", "description": "US state code or ISO country for the callee, drives one-party vs all-party consent" },
                    "tz": { "type": "string", "description": "IANA tz, drives call windows" }
                  }
                }
              }
            }
          }
        },
        "bank_details_hash": { "type": "string", "description": "Hash of remit-to details; changes require human dual control" },
        "scorecard": {
          "type": "object", "additionalProperties": false,
          "properties": { "otd_pct": { "type": "number" }, "ppm": { "type": "number" }, "quote_response_h_p50": { "type": "number" } }
        }
      }
    },

    "RFQ": {
      "type": "object", "required": ["id", "status", "lines", "suppliers", "due_at", "created_by"], "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "status": { "enum": ["draft", "approved_to_send", "sent", "collecting", "closed", "awarded", "cancelled"] },
        "build_ref": { "type": "string", "description": "e.g. PROTO-0, PILOT-100" },
        "lines": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["line", "part", "qty_breaks"], "additionalProperties": false,
            "properties": {
              "line": { "type": "integer", "minimum": 1 }, "part": { "$ref": "#/$defs/Id" }, "part_rev": { "type": "string" },
              "qty_breaks": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 1 },
              "need_by": { "type": "string", "format": "date" }, "notes": { "type": "string" },
              "attachments": { "type": "array", "items": { "$ref": "#/$defs/Attachment" } }
            }
          }
        },
        "suppliers": { "type": "array", "items": { "$ref": "#/$defs/Id" }, "minItems": 1 },
        "channel": { "enum": ["email", "api", "portal"] },
        "thread_ids": { "type": "object", "additionalProperties": { "type": "string" }, "description": "supplier id -> email thread id" },
        "due_at": { "$ref": "#/$defs/Timestamp" },
        "created_by": { "$ref": "#/$defs/Actor" }
      }
    },

    "Quote": {
      "type": "object", "required": ["id", "rfq", "supplier", "received_at", "source", "lines", "extraction"], "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Id" }, "rfq": { "$ref": "#/$defs/Id" }, "supplier": { "$ref": "#/$defs/Id" },
        "supplier_ref": { "type": "string" }, "received_at": { "$ref": "#/$defs/Timestamp" },
        "valid_until": { "type": "string", "format": "date" },
        "source": {
          "type": "object", "required": ["channel"], "additionalProperties": false,
          "properties": {
            "channel": { "enum": ["email", "api", "portal_scrape", "phone_transcript"] },
            "message_id": { "type": "string" }, "attachment": { "$ref": "#/$defs/Attachment" }
          }
        },
        "incoterm": { "enum": ["EXW", "FCA", "FOB", "CIF", "DAP", "DDP"] },
        "lines": {
          "type": "array",
          "items": {
            "type": "object", "required": ["rfq_line", "qty", "unit_price"], "additionalProperties": false,
            "properties": {
              "rfq_line": { "type": "integer" }, "mpn_offered": { "type": "string" }, "is_alternate": { "type": "boolean" },
              "qty": { "type": "integer" }, "unit_price": { "$ref": "#/$defs/Money" },
              "moq": { "type": "integer" }, "mult": { "type": "integer" },
              "lead_time_days": { "type": "integer" }, "stock": { "type": "integer" },
              "nre": { "$ref": "#/$defs/Money" }, "tooling": { "$ref": "#/$defs/Money" }
            }
          }
        },
        "extraction": {
          "type": "object", "required": ["method", "confidence"], "additionalProperties": false,
          "properties": {
            "method": { "enum": ["api", "llm_pdf", "llm_email_body", "human"] },
            "model": { "type": "string" }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "field_spans": { "type": "object", "description": "field path -> page/bbox or char span in source, for human verification" },
            "human_verified_by": { "type": "string" }
          }
        },
        "normalized": {
          "type": "object", "description": "Computed: landed cost per unit at each break in USD incl. freight, duty, FX",
          "additionalProperties": { "$ref": "#/$defs/Money" }
        }
      }
    },

    "PO": {
      "type": "object", "required": ["id", "number", "supplier", "status", "lines", "total", "approvals"], "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Id" }, "number": { "type": "string", "pattern": "^PO-[0-9]{6}$" },
        "supplier": { "$ref": "#/$defs/Id" }, "quote": { "$ref": "#/$defs/Id" },
        "status": { "enum": ["draft", "pending_approval", "approved", "sent", "acknowledged", "partially_received", "received", "closed", "cancelled"] },
        "lines": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["line", "part", "qty", "unit_price"], "additionalProperties": false,
            "properties": {
              "line": { "type": "integer" }, "part": { "$ref": "#/$defs/Id" }, "part_rev": { "type": "string" },
              "qty": { "type": "integer" }, "unit_price": { "$ref": "#/$defs/Money" },
              "promised_date": { "type": "string", "format": "date" }, "received_qty": { "type": "integer", "default": 0 }
            }
          }
        },
        "total": { "$ref": "#/$defs/Money" },
        "payment": { "enum": ["virtual_card", "ach", "wire", "net_terms"] },
        "approvals": { "type": "array", "items": { "$ref": "#/$defs/Id" } },
        "ack": {
          "type": "object", "additionalProperties": false,
          "properties": { "received_at": { "$ref": "#/$defs/Timestamp" }, "supplier_so": { "type": "string" }, "deviations": { "type": "array", "items": { "type": "string" } } }
        },
        "idempotency_key": { "type": "string", "description": "Used for every outbound side effect (email send, API order, card charge)" },
        "qbo_id": { "type": "string" }
      }
    },

    "Shipment": {
      "type": "object", "required": ["id", "direction", "status", "carrier"], "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "direction": { "enum": ["inbound", "outbound", "inter_site"] },
        "po": { "$ref": "#/$defs/Id" },
        "status": { "enum": ["label_created", "in_transit", "customs_hold", "out_for_delivery", "delivered", "exception", "returned"] },
        "carrier": { "type": "string" }, "service": { "type": "string" }, "tracking": { "type": "string" },
        "easypost_id": { "type": "string" },
        "customs": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "incoterm": { "type": "string" }, "declared_value": { "$ref": "#/$defs/Money" },
            "items": { "type": "array", "items": { "type": "object", "properties": { "part": { "$ref": "#/$defs/Id" }, "hts": { "type": "string" }, "qty": { "type": "integer" }, "value": { "$ref": "#/$defs/Money" }, "origin": { "type": "string" } } } },
            "contains_lithium": { "enum": ["none", "PI966", "PI967", "PI965"] }
          }
        },
        "eta": { "$ref": "#/$defs/Timestamp" }, "events": { "type": "array", "items": { "type": "object" } }
      }
    },

    "Gate": {
      "type": "object", "required": ["id", "name", "build_ref", "status", "criteria"], "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "name": { "enum": ["G0_concept", "G1_proto_release", "G2_evt", "G3_dvt", "G4_pvt", "G5_mp"] },
        "build_ref": { "type": "string" },
        "status": { "enum": ["open", "in_review", "passed", "passed_with_waivers", "failed"] },
        "criteria": {
          "type": "array",
          "items": {
            "type": "object", "required": ["key", "kind", "status"], "additionalProperties": false,
            "properties": {
              "key": { "type": "string", "examples": ["drc_clean", "erc_baseline", "fai_display_boot", "un38_3_report"] },
              "kind": { "enum": ["automated_check", "evidence_upload", "human_signoff"] },
              "status": { "enum": ["pending", "pass", "fail", "waived"] },
              "evidence": { "type": "array", "items": { "$ref": "#/$defs/Attachment" } },
              "waiver_approval": { "$ref": "#/$defs/Id" }
            }
          }
        },
        "approvals": { "type": "array", "items": { "$ref": "#/$defs/Id" } },
        "baseline": { "$ref": "#/$defs/GitRef", "description": "Release tag frozen by the gate" }
      }
    },

    "Approval": {
      "type": "object", "required": ["id", "subject", "action", "requested_by", "policy", "status", "required"], "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "subject": { "type": "object", "required": ["type", "id"], "properties": { "type": { "enum": ["PO", "RFQ", "ECO", "Gate", "Payment", "SupplierBankChange", "OutboundCall", "Contract", "ToolCall"] }, "id": { "type": "string" } } },
        "action": { "type": "string", "examples": ["po.send", "payment.release", "call.place", "eco.release"] },
        "summary": { "type": "string", "description": "Agent-written, rendered in Slack/email/mobile; never the sole basis: diff and source links attached" },
        "payload_hash": { "type": "string", "description": "sha256 of the exact tool input approved; executor re-hashes and refuses on mismatch" },
        "requested_by": { "$ref": "#/$defs/Actor" },
        "policy": { "type": "object", "properties": { "engine": { "enum": ["cedar", "opa"] }, "policy_id": { "type": "string" }, "reasons": { "type": "array", "items": { "type": "string" } } } },
        "required": { "type": "object", "properties": { "count": { "type": "integer", "minimum": 1 }, "roles": { "type": "array", "items": { "type": "string" } }, "distinct_from_requester": { "type": "boolean", "default": true } } },
        "decisions": {
          "type": "array",
          "items": { "type": "object", "required": ["by", "decision", "at"], "properties": { "by": { "$ref": "#/$defs/Actor" }, "decision": { "enum": ["approve", "reject", "edit_and_approve"] }, "at": { "$ref": "#/$defs/Timestamp" }, "channel": { "enum": ["slack", "email", "mobile", "web"] }, "comment": { "type": "string" }, "webauthn": { "type": "boolean" } } }
        },
        "status": { "enum": ["pending", "approved", "rejected", "expired", "superseded"] },
        "expires_at": { "$ref": "#/$defs/Timestamp" }
      }
    },

    "ECO": {
      "type": "object", "required": ["id", "number", "title", "status", "changes", "reason"], "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Id" }, "number": { "type": "string", "pattern": "^ECO-[0-9]{4}$" },
        "title": { "type": "string" },
        "reason": { "enum": ["defect", "cost_down", "supply", "compliance", "feature", "doc_only"] },
        "status": { "enum": ["draft", "impact_analysis", "in_review", "approved", "released", "implemented", "rejected"] },
        "changes": {
          "type": "array",
          "items": {
            "type": "object", "required": ["part", "from_rev", "to_rev"], "additionalProperties": false,
            "properties": {
              "part": { "$ref": "#/$defs/Id" }, "from_rev": { "type": "string" }, "to_rev": { "type": "string" },
              "git": { "$ref": "#/$defs/GitRef", "description": "PR merge commit carrying the CAD/ECAD change" },
              "bom_diff": { "type": "array", "items": { "type": "object" } }
            }
          }
        },
        "disposition": {
          "type": "object", "description": "What happens to stock and open orders",
          "properties": {
            "on_hand": { "enum": ["use_as_is", "rework", "scrap", "return_to_vendor"] },
            "open_pos": { "type": "array", "items": { "type": "object", "properties": { "po": { "$ref": "#/$defs/Id" }, "action": { "enum": ["none", "amend", "cancel"] } } } },
            "wip_builds": { "type": "array", "items": { "type": "string" } }
          }
        },
        "effectivity": { "type": "object", "properties": { "type": { "enum": ["date", "serial", "build", "lot"] }, "value": { "type": "string" } } },
        "approvals": { "type": "array", "items": { "$ref": "#/$defs/Id" } }
      }
    },

    "Event": {
      "type": "object", "required": ["id", "type", "occurred_at", "source", "subject", "data"], "additionalProperties": false,
      "description": "CloudEvents 1.0-compatible envelope on the bus. Consumers dedupe on id.",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "pattern": "^zm\\.[a-z_]+\\.[a-z_]+\\.v[0-9]+$", "examples": ["zm.quote.ingested.v1", "zm.email.inbound_quarantined.v1", "zm.po.acknowledged.v1", "zm.eco.released.v1"] },
        "occurred_at": { "$ref": "#/$defs/Timestamp" },
        "source": { "type": "string", "examples": ["agent/procurement@1.4.2", "webhook/postmark", "webhook/twilio"] },
        "subject": { "type": "string", "description": "Entity id the event is about" },
        "correlation_id": { "type": "string" }, "causation_id": { "type": "string" },
        "traceparent": { "type": "string", "description": "W3C trace context" },
        "trust": { "enum": ["internal", "untrusted"] },
        "data": { "type": "object" }
      }
    },

    "AuditEntry": {
      "type": "object", "required": ["seq", "at", "actor", "action", "subject", "result", "prev_hash", "hash"], "additionalProperties": false,
      "description": "Append-only, hash-chained. Written by the tool gateway, never by the agent. Daily root hash anchored to Git (signed tag) and WORM object storage.",
      "properties": {
        "seq": { "type": "integer", "minimum": 0 },
        "at": { "$ref": "#/$defs/Timestamp" },
        "actor": { "$ref": "#/$defs/Actor" },
        "on_behalf_of": { "type": "string", "description": "Human principal whose delegation the agent used" },
        "action": { "type": "string", "examples": ["tool.call:mcp__digikey__create_order", "email.send", "call.start", "approval.decide", "secret.lease"] },
        "subject": { "type": "string" },
        "input_hash": { "type": "string" }, "output_hash": { "type": "string" },
        "policy_decision": { "type": "object", "properties": { "allowed": { "type": "boolean" }, "policy_ids": { "type": "array", "items": { "type": "string" } } } },
        "approval": { "type": "string" },
        "result": { "enum": ["ok", "denied", "error", "pending_approval"] },
        "cost": { "type": "object", "properties": { "tokens_in": { "type": "integer" }, "tokens_out": { "type": "integer" }, "usd": { "type": "number" } } },
        "trace_id": { "type": "string" },
        "prev_hash": { "type": "string" }, "hash": { "type": "string", "description": "sha256(prev_hash || canonical_json(entry without hash))" }
      }
    }
  }
}
